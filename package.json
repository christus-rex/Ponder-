{
  "name": "ponder-plus",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "mobile": "npm --workspace @ponder/mobile run start",
    "test": "node --experimental-strip-types --test packages/domain/test/*.test.ts",
    "typecheck": "tsc -p packages/domain/tsconfig.json --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "qa": "npm run test && npm run typecheck",
    "audit:ci": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~6.0.3"
  }
}
