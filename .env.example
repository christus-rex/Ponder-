# Realtime translator demo (server-side only)
OPENAI_API_KEY=sk-your-server-side-key
PORT=8787

# Dedicated Ponder+ Supabase project — web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dedicated Ponder+ Supabase project — Expo mobile.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only if a publishable key is not yet available:
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Base Sepolia only during the crypto spike.
NEXT_PUBLIC_PONDER_TIP_RECIPIENT=

# Server-only secrets belong in deployment secret managers, never public env vars:
SUPABASE_SERVICE_ROLE_KEY=
# CLOUDFLARE_REALTIME_API_TOKEN
# CLOUDFLARE_R2_ACCESS_KEY_ID
# CLOUDFLARE_R2_SECRET_ACCESS_KEY
# STRIPE_SECRET_KEY

# Room Brain realtime authorization.
# Use the same 32+ character Room Brain secret in the Next.js backend and Cloudflare Worker.
ROOM_BRAIN_AUTH_SECRET=
NEXT_PUBLIC_ROOM_BRAIN_WS_URL=
# Required in production: comma-separated hostnames the Next.js backend may send Room Brain bearer tokens to.
ROOM_BRAIN_ALLOWED_HOSTS=

# Media capabilities are signed separately from Room Brain connection tickets.
# Configure on the Room Brain Worker and trusted Next.js SFU exchange endpoint only.
MEDIA_SESSION_AUTH_SECRET=

# Private scheduled media-revocation reconciliation. Keep server-side only and
# use an independent 32+ character random value.
MEDIA_RECONCILIATION_SECRET=

# RealtimeKit provider exchange (server-only; never expose these through NEXT_PUBLIC_*).
CLOUDFLARE_ACCOUNT_ID=
REALTIMEKIT_APP_ID=
CLOUDFLARE_REALTIME_API_TOKEN=
REALTIMEKIT_SUBSCRIBE_ONLY_PRESET=
REALTIMEKIT_PUBLISHER_PRESET=
# Optional controlled deployment override. Defaults to https://api.cloudflare.com/client/v4.
REALTIMEKIT_API_BASE=
# Comma-separated hostname allowlist only when a controlled non-default API host is required.
REALTIMEKIT_ALLOWED_API_HOSTS=
