# Realtime translator demo (server-side only)
OPENAI_API_KEY=sk-your-server-side-key
PORT=8787

# Dedicated Ponder+ Supabase project — web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dedicated Ponder+ Supabase project — Expo mobile.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Base Sepolia only during the crypto spike.
NEXT_PUBLIC_PONDER_TIP_RECIPIENT=

# Server-only secrets belong in deployment secret managers, never public env vars:
# SUPABASE_SERVICE_ROLE_KEY
# CLOUDFLARE_REALTIME_API_TOKEN
# CLOUDFLARE_R2_ACCESS_KEY_ID
# CLOUDFLARE_R2_SECRET_ACCESS_KEY
# STRIPE_SECRET_KEY

# Room Brain realtime authorization.
# Use the same 32+ character secret in the Next.js backend and Cloudflare Worker.
ROOM_BRAIN_AUTH_SECRET=
NEXT_PUBLIC_ROOM_BRAIN_WS_URL=
